# ============================================
# Tec360 Seguridad — Variables de Producción
# ============================================
# Copiar a .env.production y llenar con valores reales
# NUNCA subir .env.production al repositorio
# ============================================

# --- Entorno ---
ENVIRONMENT=production
DEBUG=False

# --- Base de datos ---
DB_USER=tec360
DB_PASSWORD=CAMBIAR_AQUI_PASSWORD_SEGURO
DB_NAME=tec360
DB_PORT=5432

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_AQUI_SECRET_KEY_SEGURO

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=tu-api-key-de-google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google

# --- API URL (como la ve el frontend) ---
NEXT_PUBLIC_API_URL=/api

# --- Twilio (SMS/OTP) ---
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Servidor ---
APP_PORT=80
