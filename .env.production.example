# ============================================
# Tec360 Seguridad — Variables de Producción
# ============================================
# Copiar a .env.production y llenar con valores reales
# NUNCA subir .env.production al repositorio
# ============================================

# --- Entorno ---
ENVIRONMENT=production
DEBUG=False

# --- Base de datos ---
DB_USER=tec360
DB_PASSWORD=CAMBIAR_AQUI_PASSWORD_SEGURO
DB_NAME=tec360
DB_PORT=5432

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_AQUI_SECRET_KEY_SEGURO

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=tu-api-key-de-google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google

# --- API URL (como la ve el frontend) ---
NEXT_PUBLIC_API_URL=/api

# --- Analítica Web (100% Gratis y Ultraligera) ---
NEXT_PUBLIC_GA_ID=G-Y1SLRH39KB
NEXT_PUBLIC_CLARITY_ID=ys9xbyaov1

# --- Twilio (SMS/OTP) ---
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Servidor ---
APP_PORT=80

# --- Dominio y SSL ---
DOMAIN=tudominio.com
CERT_EMAIL=tu@email.com

# --- Firebase Phone Auth (Google Identity Platform - 10.000 SMS/mes Gratis) ---
# Clave privada backend (Service Account)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Alternativa directa: Pegar el JSON completo minificado en una sola línea (recomendado en producción):
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"tec-360",...}'
# Claves públicas web / mobile client (desde Firebase Console -> Configuración de proyecto -> Tu app Web)
NEXT_PUBLIC_FIREBASE_API_KEY=tu_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tec-360.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tec-360
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tec-360.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_firebase_app_id

# --- SMS Toggle (Twilio fallback tradicional) ---
SMS_ENABLED=false

# --- Notificaciones Push Unificadas (VAPID) ---
# Generar claves con npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:tu_correo_de_administrador@dominio.com

# --- Object Storage (Oracle Cloud Infrastructure) ---
# En OCI (Rose Diamond), el volumen docker 'uploads_data' es persistente y Nginx sirve /uploads/ directamente.
STORAGE_BACKEND=local
# Si se desea usar OCI Object Storage (API compatible con S3):
# OCI_STORAGE_KEY=tu_customer_secret_key_id
# OCI_STORAGE_SECRET=tu_customer_secret_key
# OCI_STORAGE_REGION=sa-bogota-1
# OCI_STORAGE_BUCKET=tec360-uploads
# OCI_STORAGE_ENDPOINT=https://tu-namespace.compat.objectstorage.sa-bogota-1.oraclecloud.com

# --- SaaS Vertical Integration ---
SAS_BASE_URL=http://10.0.0.173/api/v1
SAS_VERTICAL_API_KEY=sk_live__0HOO0H8lm5KvFaWGwRmrGwZomp0Telg

# --- Recargas manuales Bre-B + Bot de Telegram (costo $0) ---
# 1) Crea el bot con @BotFather y obtén el token
# 2) Obtén tu chat_id enviando /start a @userinfobot
# 3) Genera un secreto: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TOPUP_PAYEE_KEY=
TOPUP_PAYEE_NAME=Tec360 Seguridad
# Imagen estática del QR Bre-B exportado desde Nequi/Bancolombia (servida por frontend /images/... o backend /static/...)
TOPUP_QR_URL=/images/qr-bre-b.png
TOPUP_MIN_AMOUNT=10000
TOPUP_MAX_AMOUNT=2000000
SIMULATION_ENABLED=false


